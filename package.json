{
  "name": "docverse-upload",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for uploading documentation builds to Docverse",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prep-openapi": "node scripts/prep-openapi.mjs",
    "generate-types": "openapi-typescript openapi.json --output generated/api-types.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "openapi-fetch": "^0.17.0",
    "tar": "^7.5.20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-license": "^1.2.3",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "msw"
    ]
  }
}
