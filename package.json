{
  "name": "docverse-upload",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for uploading documentation builds to Docverse",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt --transpile-only",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prep-openapi": "node scripts/prep-openapi.mjs",
    "generate-types": "openapi-typescript openapi.json --output generated/api-types.ts"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "openapi-fetch": "^0.17.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@vercel/ncc": "^0.38.3",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "msw"
    ]
  }
}
